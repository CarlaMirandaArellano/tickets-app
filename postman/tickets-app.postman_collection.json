              "raw": "{\n  \"eventoId\": \"evento123\",\n  \"eventoNombre\": \"Concierto Rock Duoc\",\n  \"fechaEvento\": \"2026-12-15T21:00:00\",\n  \"lugar\": \"Movistar Arena, Santiago\",\n  \"usuarioId\": \"usuarioX\",\n  \"usuarioNombre\": \"María González\",\n  \"usuarioEmail\": \"usuariox@correo.cl\",\n  \"tipoEntrada\": \"VIP\",\n  \"asiento\": \"VIP-12\",\n  \"precio\": 25000,\n  \"estado\": \"PAGADO\"\n}",
