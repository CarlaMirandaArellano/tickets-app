              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set(\"ticketId\", t.id);",
                  "pm.test(\"PDF guardado en EFS\", () => pm.expect(t.rutaEfs).to.include(\"/tickets/\"));",
                  "pm.test(\"Subido a S3 como evento/usuario/ticketXXX.pdf\", () => pm.expect(t.s3Key).to.match(/^[^/]+\\/[^/]+\\/ticket\\d+\\.pdf$/));"
